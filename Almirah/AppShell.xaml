<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Almirah.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Almirah.Views"
    xmlns:notes="clr-namespace:Almirah.Views.Notes"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
    <ShellContent Route="MainPage" ContentTemplate="{DataTemplate views:MainPage}" />
    
    <ShellContent Route="ViewPage" ContentTemplate="{DataTemplate notes:ViewPage}" />
    </TabBar>
</Shell>    