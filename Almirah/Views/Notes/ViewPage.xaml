<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almirah.Views.Notes.ViewPage">
    <ContentPage.Content>
        <StackLayout Padding="20">
            <Entry Placeholder="Title" Text="{Binding SelectedNote.Title}" />
            <Editor Placeholder="Content" Text="{Binding SelectedNote.Content}" HeightRequest="200" />
            <Button Text="Save" Command="{Binding SaveNoteCommand}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>