<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almirah.Views.Notes.ViewPage"
             BackgroundColor="{DynamicResource DarkBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Define colors for dark mode -->
            <Color x:Key="DarkBackgroundColor">#1E1E1E</Color>
            <Color x:Key="CardBackgroundColor">#2E2E2E</Color>
            <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
            <Color x:Key="SecondaryTextColor">#B0B0B0</Color>
            <Color x:Key="ButtonBackgroundColor">#4CAF50</Color>
            <Color x:Key="CancelButtonColor">#FF6B6B</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid Padding="20" RowSpacing="15" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Entry -->
            <Entry Placeholder="Enter title"
                   Text="{Binding SelectedNote.Title}"
                   Grid.Row="0"
                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   PlaceholderColor="{DynamicResource SecondaryTextColor}"
                   Margin="0,10,0,10"
                   HeightRequest="50"
                   VerticalOptions="Center" />

            <!-- Content Editor -->
            <Editor Placeholder="Enter content here"
                    Text="{Binding SelectedNote.Content}"
                    Grid.Row="2"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    PlaceholderColor="{DynamicResource SecondaryTextColor}"
                    Margin="0,0,0,20"
                    VerticalOptions="FillAndExpand" />

            <!-- Buttons Layout -->
            <StackLayout Orientation="Horizontal"
                         Spacing="20"
                         Grid.Row="3"
                         HorizontalOptions="CenterAndExpand">
                <!-- Cancel Button -->
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{DynamicResource CancelButtonColor}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        WidthRequest="120" />

                <!-- Save/Update Button -->
                <Button BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        WidthRequest="120">
                    <Button.Triggers>
                        <!-- Trigger based on the boolean IsNoteNew property -->
                        <DataTrigger TargetType="Button" Binding="{Binding IsNoteNew}" Value="true">
                            <Setter Property="Text" Value="Save" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsNoteNew}" Value="false">
                            <Setter Property="Text" Value="Update" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.Command>
                        <Binding Path="SaveNoteCommand" />
                    </Button.Command>
                </Button>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>