<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Almirah.Views.MainPage"
             Title="Note$">

    <StackLayout Padding="20">
        <Button Text="Add Note" Command="{Binding AddNoteCommand}" HorizontalOptions="Center" />
        <ListView ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Title}" Detail="{Binding UpdatedAt, 
                    StringFormat='Last updated: {0:g}'}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>